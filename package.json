{
  "name": "justaskcory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "dev": "concurrently -k \"npm:watch:css\" \"npm:start\"",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}

